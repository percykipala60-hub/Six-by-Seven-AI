# Copier en deploy/.env sur le serveur, puis remplir. Ce fichier est secret : jamais dans Git,
# jamais dans un chat, un e-mail ou une capture d'écran.

# Votre nom de domaine, sans https:// ni www
DOMAINE=sixbysevenai.com

# --- IA (au moins un fournisseur ; sans clé, Six répond avec des exemples) ---
AI_PROVIDERS=claude,openai,openrouter
ANTHROPIC_API_KEY=
CLAUDE_MODEL_ANALYSE=claude-haiku-4-5-20251001
CLAUDE_MODEL_REDACTION=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL_ANALYSE=
OPENAI_MODEL_REDACTION=

# OpenRouter est actif quand une clé et un modèle au format fournisseur/modele sont définis.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ELEVENLABS_API_KEY=
PROVIDER_TIMEOUT_MS=30000
# Plafond d'appels à l'IA par jour (0 = pas de plafond)
AI_DAILY_LIMIT=1000

# --- Protection de l'API ---
# Un seul serveur : le compteur de débit tourne en mémoire, pas besoin d'Upstash.
# Autres origines autorisées (l'app Android utilise l'adresse de l'app, rien à ajouter)
ALLOWED_ORIGINS=

# --- Comptes (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- E-mails de connexion (codes, confirmation, mot de passe) ---
# Supabase confie l'envoi à l'app (Authentication > Auth Hooks > Send Email Hook, adresse
# https://app.sixbysevenai.com/api/auth/email) ; l'app limite à 5 e-mails par heure et 10 par jour
# et par adresse, puis envoie par Resend. Les deux valeurs sont secrètes : à coller sur le serveur seulement.
RESEND_API_KEY=
SUPABASE_EMAIL_HOOK_SECRET=

# --- Six Premium (achats intégrés Apple dans l'app iPhone) ---
# Sans la clé Supabase et APPLE_ACHATS=oui, le premium reste en veille : aucune limite, meilleur modèle pour tous
# (voir app/docs/premium.md).
# Clé secrète du projet Supabase (Settings > API keys > secret, ou l'ancienne service_role).
# Elle contourne les règles d'accès : serveur seulement, jamais dans une variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# oui : achats intégrés Apple ouverts. APPLE_ACHATS_SANDBOX=oui seulement pendant les essais TestFlight.
APPLE_ACHATS=
APPLE_ACHATS_SANDBOX=
# Prix des pass et devise (USD ou CDF).
PREMIUM_DEVISE=USD
PREMIUM_PRIX_7J=3
PREMIUM_PRIX_30J=7
# Limites de la version gratuite, par jour et par compte (0 = sans limite).
GRATUIT_ANALYSES_JOUR=5
GRATUIT_MESSAGES_SEVEN_JOUR=20
# Modèle de rédaction de la version gratuite (le premium garde CLAUDE_MODEL_REDACTION).
CLAUDE_MODEL_REDACTION_GRATUIT=claude-haiku-4-5-20251001

# Tâches planifiées : secret aléatoire de 32 caractères minimum, puis activer le profil planification.
SIX_CRON_SECRET=
