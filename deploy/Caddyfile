# Adresses de Six (DOMAINE est défini dans deploy/.env, ex. sixbyseven.app).
# - app.DOMAINE : l'application (site, API, page /rapide utilisée par la bulle et le clavier Android)
# - DOMAINE et www.DOMAINE : renvoient vers l'application, en attendant le site de présentation

app.{$DOMAINE} {
	encode zstd gzip
	reverse_proxy six:3000
	# Journal technique sans contenu : ni corps de requête, ni paramètres d'adresse.
	log {
		output stdout
		format filter {
			request>uri query {
				delete
			}
			request>headers delete
		}
	}
}

{$DOMAINE}, www.{$DOMAINE} {
	redir https://app.{$DOMAINE}{uri} permanent
}
