# Adresses (DOMAINE est défini dans deploy/.env : sixbysevenai.com).
# - DOMAINE          : le site de présentation (dossier site/, construit par le service « site »)
# - www.DOMAINE      : renvoie vers DOMAINE
# - app.DOMAINE      : l'application Six (site, API, page /rapide de la bulle et du clavier Android)

{$DOMAINE} {
	root * /srv/site
	encode zstd gzip
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	# Fichiers dont le nom change à chaque version : gardés longtemps en cache.
	@immuable path /assets/* /fonts/*
	header @immuable Cache-Control "public, max-age=31536000, immutable"
	# Chaque page a son propre fichier HTML (écrit au build, voir site/vite.config.ts) : /telecharger sert
	# telecharger/index.html, avec son titre et son adresse canonique, pour les moteurs de recherche.
	try_files {path} {path}/index.html
	file_server
	# Adresse inconnue : vraie erreur 404 (les moteurs ne la gardent pas), avec la page « perdue » du site.
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

www.{$DOMAINE} {
	redir https://{$DOMAINE}{uri} permanent
}

app.{$DOMAINE} {
	encode zstd gzip
	reverse_proxy six:3000
	# Journal technique sans contenu : ni en-têtes, ni paramètres d'adresse (tout ce qui suit « ? »).
	log {
		output stdout
		format filter {
			request>headers delete
			request>uri regexp \?.* ""
		}
	}
}
