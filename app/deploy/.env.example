# Copier en deploy/.env sur le serveur, puis remplir. Ce fichier est secret : jamais dans Git,
# jamais dans un chat, un e-mail ou une capture d'écran.

# Votre nom de domaine, sans https:// ni www
DOMAINE=sixbysevenai.com

# --- IA (au moins un fournisseur ; sans clé, Six répond avec des exemples) ---
AI_PROVIDERS=claude,openai
ANTHROPIC_API_KEY=
CLAUDE_MODEL_ANALYSE=claude-haiku-4-5-20251001
CLAUDE_MODEL_REDACTION=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL_ANALYSE=
OPENAI_MODEL_REDACTION=
PROVIDER_TIMEOUT_MS=30000
# Plafond d'appels à l'IA par jour (0 = pas de plafond)
AI_DAILY_LIMIT=1000

# --- Protection de l'API ---
# Un seul serveur : le compteur de débit tourne en mémoire, pas besoin d'Upstash.
# Autres origines autorisées (l'app Android utilise l'adresse de l'app, rien à ajouter)
ALLOWED_ORIGINS=

# --- Comptes (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
