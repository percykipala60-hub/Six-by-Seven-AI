# Copie ce fichier en .env (jamais commité). Chaque variable est validée par src/env.ts au démarrage.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Origines autorisées à appeler l'API, séparées par des virgules (aucun joker).
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
# Nombre de proxies de confiance qui ajoutent l'adresse source, requis en production.
TRUST_PROXY_HOPS=1
# Modèle qui rédige pour l'app : auto = Claude si la clé est remplie, sinon Ollama local.
AI_PROVIDER=auto
# Clé Anthropic, côté serveur uniquement (jamais dans l'app web).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Redis partagé pour la limite par minute (requis en production, TLS rediss://).
REDIS_URL=

# --- Essais d'IA (pnpm essai-ia) ---
# Serveur local Ollama : rien ne quitte la machine. Toujours essayé.
OLLAMA_URL=http://localhost:11434/v1
# Un ou plusieurs modèles, séparés par des virgules (ex. llama3.2:3b,mistral:7b).
OLLAMA_MODEL=llama3.2:3b
# Délai max en secondes (un modèle 7B sur processeur peut prendre plusieurs minutes).
OLLAMA_TIMEOUT_S=600
# API gratuites en ligne : actives seulement si la clé est remplie.
# Attention : leurs offres gratuites peuvent utiliser les conversations pour entraîner leurs modèles.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
