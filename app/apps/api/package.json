{
  "name": "@six/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de Six (Fastify). Phase 1 : squelette, sécurité de base, /health.",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "essai-ia": "tsx --conditions=source --env-file-if-exists=.env scripts/essai-ia.ts",
    "banc": "tsx --conditions=source --env-file-if-exists=.env scripts/banc.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.3.0",
    "@six/shared": "workspace:*",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
