# ============================================================
# Clés d'API : SECRÈTES. Copie ce fichier en .env.local (jamais .env.example),
# ne le commite jamais, ne colle jamais une clé dans un chat, un mail ou un document.
# Ces clés restent sur le serveur : l'app ne les envoie jamais au navigateur.
# Sans aucune clé, Six répond avec un faux modèle (bandeau « Mode démonstration »).
# Après avoir rempli, lance :  npm run check-ai   pour tester chaque clé.
# ============================================================

# Ordre d'essai : le premier service qui répond gagne, le suivant prend le relais en cas de panne.
AI_PROVIDERS=claude,openai,openrouter

# --- Claude (Anthropic) : console.anthropic.com > API keys ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_ANALYSE=claude-haiku-4-5-20251001
CLAUDE_MODEL_REDACTION=claude-sonnet-5-5

# --- ChatGPT (OpenAI) : platform.openai.com > API keys ---
# Pas de modèle par défaut : choisis-le dans la doc OpenAI (un petit pour l'analyse, un meilleur pour la rédaction).
OPENAI_API_KEY=
OPENAI_MODEL_ANALYSE=
OPENAI_MODEL_REDACTION=
# (ou un seul modèle pour tout : OPENAI_MODEL=)

# OpenRouter est actif quand une clé et un modèle au format fournisseur/modele sont définis.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Synthèse ElevenLabs pour les voix sélectionnées dans Six.
ELEVENLABS_API_KEY=

# --- IA locale de Seven.AI (Ollama sur ce PC, sans clé) : voir ia/README.md ---
# Ajoute « local » à AI_PROVIDERS et indique le modèle.
IA_LOCALE_MODELE=
# IA_LOCALE_URL=http://127.0.0.1:11434
# IA_LOCALE_CONTEXTE=8192

# 120000 conseillé avec l'IA locale (le premier message charge le modèle sur la carte graphique).
PROVIDER_TIMEOUT_MS=30000

# --- Protection de l'API et du budget ---
# Plafond de tentatives fournisseur par jour et par serveur (0 = pas de plafond), replis compris.
AI_DAILY_LIMIT=1000
# Nombre de relais de confiance devant l'app (l'hébergeur) qui ajoutent l'adresse du client dans X-Forwarded-For.
# À mettre (souvent 1) en production ; la chaîne doit correspondre aux relais de confiance de l'hébergeur.
TRUST_PROXY=
# Compteur partagé Upstash Redis REST ; requis en production. RATE_LIMIT_HASH_SECRET doit contenir au moins 32 caractères aléatoires.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HASH_SECRET=
# Autres adresses du site autorisées à appeler l'API (ex. https://six.example), séparées par des virgules.
# Pour le prototype Six Clavier (Android), ajouter : android-app://ai.seven.six.clavier
ALLOWED_ORIGINS=
# Hôtes autorisés par Next.js en développement pour tester depuis un autre appareil (sans http://).
ALLOWED_DEV_ORIGINS=
# Uniquement pour des outils de test : accepter les requêtes sans en-tête Origin (laisser vide en production).
ALLOW_NO_ORIGIN=

# Connexion par e-mail ou téléphone et mémoire synchronisée (Supabase). Sans ces deux valeurs, Six reste en mode invité.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Six Premium (achats intégrés Apple) : voir deploy/.env.example pour le détail ---
SUPABASE_SERVICE_ROLE_KEY=
APPLE_ACHATS=
APPLE_ACHATS_SANDBOX=
PREMIUM_DEVISE=USD
PREMIUM_PRIX_7J=3
PREMIUM_PRIX_30J=7
GRATUIT_ANALYSES_JOUR=5
GRATUIT_MESSAGES_SEVEN_JOUR=20
CLAUDE_MODEL_REDACTION_GRATUIT=claude-haiku-4-5-20251001

# Transcription vocale par un moteur faster-whisper (app/scripts/transcription-locale.py), ex. http://127.0.0.1:8765.
# SIX_TRANSCRIPTION_LOCALE=
