<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.orca" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.google.android.gm" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- Retour de la connexion Apple ou Google (Supabase renvoie vers six://auth). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="six" android:host="auth" />
            </intent-filter>
            <!-- Liens https://app.sixbysevenai.com/… : ouverts dans l'app (vérifiés par /.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.sixbysevenai.com" />
            </intent-filter>
        </activity>

        <activity-alias android:name=".LauncherBleu" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true" android:icon="@drawable/six_theme_bleu" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherRouge" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_rouge" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherRose" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_rose" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherViolet" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_violet" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherNeon" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_neon" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherJaune" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_jaune" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherVert" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_vert" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAmbre" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_ambre" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGris" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_gris" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherFacebook" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_facebook" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherSms" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_sms" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherWhatsapp" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_whatsapp" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherLinkedin" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_linkedin" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherTelegram" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_telegram" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherInstagram" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_instagram" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherTiktok" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_tiktok" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGoogle" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_google" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherClaude" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_claude" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherKimi" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_kimi" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherPinterest" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/six_theme_pinterest" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <service
            android:name=".SixNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Panneau rapide : ouvert par la bulle et le clavier Six, par-dessus la messagerie. -->
        <activity
            android:name=".RapideActivity"
            android:theme="@style/SixRapide"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.sevenai.six.rapide"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- Bulle Six, visible par-dessus les autres applications. -->
        <service
            android:name=".BulleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Bulle flottante qui ouvre les réponses proposées par Six" />
        </service>

        <!-- Clavier Six : écrit la réponse choisie dans le champ de la messagerie. -->
        <service
            android:name=".SixClavier"
            android:label="@string/clavier_nom"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/methode_clavier" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Micro du Chat (dictée et messages vocaux) : demandé au moment du clic sur le micro.
         Sans ces deux lignes, Android refuse le micro sans rien demander. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Caméra : scanner le code QR de connexion d'un autre appareil (components/ScannerQr.tsx). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
