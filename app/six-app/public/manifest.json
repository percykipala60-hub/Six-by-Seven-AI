{
  "name": "Six — Seven.AI",
  "short_name": "Six",
  "description": "Colle une conversation, Six propose trois réponses. Tu choisis, tu envoies.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#12151c",
  "theme_color": "#1F3864",
  "lang": "fr",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Nouvelle conversation",
      "url": "/?action=nouvelle"
    },
    {
      "name": "Coller et analyser",
      "url": "/?action=coller"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "chat",
          "accept": [
            "text/plain",
            ".txt",
            "application/zip",
            ".zip"
          ]
        },
        {
          "name": "captures",
          "accept": [
            "image/*",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp"
          ]
        }
      ]
    }
  }
}
