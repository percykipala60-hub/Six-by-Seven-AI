# Clés secrètes de ZEUS — copie ce fichier en « .env » (même dossier) et remplis seulement ce que tu utilises.
# ZEUS lit .env au démarrage. Ne partage jamais ton fichier .env.

# Claude (Anthropic) : si aucun modèle n'est configuré, ZEUS branche tout seul la « Puissance maximale »
# (Opus 5.5 principal, Fable 5.1 en mode maximum, Haiku 5.5 en tâches de fond).
ANTHROPIC_API_KEY=

# Groq ou OpenAI : sert aussi à la transcription de la voix (Whisper), en français, anglais, espagnol, allemand…
GROQ_API_KEY=
OPENAI_API_KEY=

# Pour les autres fournisseurs, ajoute le modèle dans Réglages → Modèles et mets « env:NOM_DE_LA_VARIABLE » comme clé.
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Dossier des données (facultatif ; par défaut : le dossier « data » à côté de zeus.py)
# ZEUS_HOME=D:/ZEUS-donnees
