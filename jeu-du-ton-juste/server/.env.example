# Copie ce fichier en .env et remplis la clé. Ne mets jamais .env dans Git.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORT=3010
# Modèle utilisé pour noter les réponses (le même Sonnet que six-app).
CLAUDE_MODEL=claude-sonnet-5-5
# Adresses autorisées à appeler le serveur, séparées par des virgules.
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:4173,http://127.0.0.1:4173
