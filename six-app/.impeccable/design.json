      "html": "<header class=\"ds-appbar\"><button class=\"ds-round\" aria-label=\"Ouvrir le menu\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 7h16M4 12h16M4 17h10\"/></svg></button><span class=\"ds-appbar-title\">Six</span><a class=\"ds-avatar\" href=\"#\" aria-label=\"Profil d'Awa : invitée\">A<span class=\"ds-dot\"></span></a></header>",
      "css": ".ds-appbar{display:flex;align-items:center;gap:4px;min-height:56px;padding:6px 8px;background:color-mix(in srgb,var(--bg,#f5f6fa) 94%,transparent)}.ds-round{width:44px;height:44px;flex:none;display:grid;place-items:center;border:0;border-radius:50%;background:none;color:var(--ink,#1b1f2a);cursor:pointer}.ds-round:active{background:var(--panel2,#eceff6)}.ds-round:focus-visible,.ds-avatar:focus-visible{outline:3px solid var(--brand,#1f3864);outline-offset:2px}.ds-appbar-title{flex:1;padding-left:2px;font-weight:700;font-size:1.1rem;letter-spacing:-.01em;color:var(--ink,#1b1f2a)}.ds-avatar{position:relative;flex:none;width:36px;height:36px;margin:0 4px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,var(--accent-a,#1f3864),var(--accent-b,#3a67b8));color:var(--on-accent,#fff);font-weight:700;font-size:.95rem;text-decoration:none}.ds-dot{position:absolute;right:-1px;bottom:-1px;width:11px;height:11px;border-radius:50%;background:var(--muted,#5b6475);box-shadow:0 0 0 2px var(--bg,#f5f6fa)}"
    },
    {
      "name": "Pilule de saisie",
      "kind": "input",
