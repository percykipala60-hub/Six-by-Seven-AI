  "components": [
    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action principale d'un écran, en dégradé d'action.",
      "html": "<button class=\"ds-btn-primary\">Copier la réponse</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 16px;border-radius:14px;border:1px solid transparent;font:inherit;font-weight:700;cursor:pointer;background:linear-gradient(135deg,var(--accent-a,#1f3864),var(--accent-b,#3a67b8));color:var(--on-accent,#fff);box-shadow:var(--sh-2,0 8px 24px rgb(16 24 40 / .10)),inset 0 1px 0 rgb(255 255 255 / .18);transition:transform .12s ease,box-shadow .15s ease}.ds-btn-primary:focus-visible{outline:3px solid var(--brand,#1f3864);outline-offset:2px}.ds-btn-primary:active{transform:translateY(1px) scale(.99)}.ds-btn-primary:disabled{opacity:.55;cursor:not-allowed}"
    },
