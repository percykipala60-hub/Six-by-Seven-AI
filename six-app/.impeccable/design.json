      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 16px;border-radius:14px;border:1px solid var(--line,#dde1ea);background:transparent;color:var(--ink,#1b1f2a);font:inherit;font-weight:600;cursor:pointer;transition:transform .12s ease}.ds-btn-ghost:focus-visible{outline:3px solid var(--brand,#1f3864);outline-offset:2px}.ds-btn-ghost:active{transform:translateY(1px) scale(.99)}"
    },
    {
